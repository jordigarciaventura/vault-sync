#!/bin/sh
# Enforce Conventional Commits (used to group the release changelog).
# Install with `task hooks`.
set -eu
msg=$(head -n1 "$1")
case "$msg" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac
if ! printf '%s' "$msg" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: .+'; then
  echo "commit-msg: use Conventional Commits, e.g. 'feat(bitwarden): resolve attachments'" >&2
  echo "            got: $msg" >&2
  exit 1
fi
